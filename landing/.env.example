# WhatsApp al que escriben los interesados desde la landing, en formato internacional
# (ej. +57 300 123 4567). Es el mismo número del soporte de Turnoo (SOPORTE_WHATSAPP del panel).
# Es público: queda escrito en los enlaces de la página. Sin él, la landing no compila.
NEXT_PUBLIC_WHATSAPP=

# Dirección del panel, a donde llevan "Iniciar sesión" y "Entrar al panel". Opcional: sin ella,
# https://app.turnooapp.com.
NEXT_PUBLIC_PANEL_URL=
