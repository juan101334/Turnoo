# Producción. Copia este archivo como "backend/.env.produccion" EN EL SERVIDOR y llena los valores.
# Nunca se sube a GitHub. Guarda una copia en un gestor de contraseñas.
#
# NODE_ENV, PORT, DATABASE_URL, ARCHIVOS_DIR y SALTOS_PROXY los fija docker-compose.prod.yml:
# no hace falta ponerlos aquí, y si se ponen no cuentan.

LOG_LEVEL=info

# Dirección del panel web, para los enlaces de invitación y recuperación de contraseña.
PANEL_URL=https://app.turnooapp.com

# Webhook de WhatsApp: App Secret del panel de Meta y el token de verificación que inventas tú.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Clave que cifra los tokens de Meta en la base: openssl rand -base64 32
# Si se pierde, hay que volver a registrar el token de cada cuenta de WhatsApp.
CLAVE_CIFRADO_TOKENS=

# IA (OpenAI). Vacía, la API arranca pero no responde por WhatsApp.
OPENAI_API_KEY=
OPENAI_MODELO=gpt-6-luna
OPENAI_ESFUERZO=low
OPENAI_MODELO_AUDIO=gpt-transcribe
