# Copia este archivo como ".env" dentro de backend/ y ajusta los valores.
# El archivo ".env" real NUNCA se sube a GitHub.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Conexión con el rol de la aplicación (turnoo_app, NO turnoo_admin).
# Desde tu equipo el puerto es 5433 (el de docker-compose.yml).
DATABASE_URL=postgresql://turnoo_app:CAMBIA_ESTA_CONTRASENA@localhost:5433/turnoo

# Dirección del panel web (para los enlaces de invitación y recuperación de contraseña).
PANEL_URL=http://localhost:3001

# Cuántos proxies propios hay delante de la API. 0 en desarrollo; 1 detrás de Caddy.
# Con 0 se ignora X-Forwarded-For. Un valor mayor al real permite falsificar la IP.
SALTOS_PROXY=0

# Webhook de WhatsApp. El App Secret sale del panel de Meta; el token de verificación lo inventas tú
# y escribes el mismo en Meta. Vacíos, el webhook rechaza todo. NUNCA los subas a GitHub.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
