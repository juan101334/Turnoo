# Copia este archivo como ".env" dentro de backend/ y ajusta los valores.
# El archivo ".env" real NUNCA se sube a GitHub.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Conexión con el rol de la aplicación (turnoo_app, NO turnoo_admin).
# Desde tu equipo el puerto es 5433 (el de docker-compose.yml).
DATABASE_URL=postgresql://turnoo_app:CAMBIA_ESTA_CONTRASENA@localhost:5433/turnoo

# Dirección del panel web (para los enlaces de invitación y recuperación de contraseña).
PANEL_URL=http://localhost:3001

# Cuántos proxies propios hay delante de la API. 0 en desarrollo; 1 detrás de Caddy.
# Con 0 se ignora X-Forwarded-For. Un valor mayor al real permite falsificar la IP.
SALTOS_PROXY=0

# Webhook de WhatsApp. El App Secret sale del panel de Meta; el token de verificación lo inventas tú
# y escribes el mismo en Meta. Vacíos, el webhook rechaza todo. NUNCA los subas a GitHub.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Clave para cifrar los tokens de Meta que se guardan en la base (32 bytes en base64).
# Genérala con: openssl rand -base64 32
# Si la pierdes, hay que volver a registrar el token de cada cuenta. NUNCA la subas a GitHub.
CLAVE_CIFRADO_TOKENS=

# IA (OpenAI). La clave se crea en https://platform.openai.com/api-keys y NUNCA se sube al repositorio.
# Vacía, la API arranca pero no responde por WhatsApp.
OPENAI_API_KEY=
# Modelo y esfuerzo de razonamiento (none, low, medium, high).
OPENAI_MODELO=gpt-6-luna
OPENAI_ESFUERZO=low
# Modelo que transcribe las notas de voz.
OPENAI_MODELO_AUDIO=gpt-transcribe

# Tarifas para estimar el costo de cada negocio en el panel del superadmin, en pesos colombianos:
# por millón de tokens de entrada, por millón de tokens de salida, por minuto de audio transcrito
# y por mensaje de utilidad de WhatsApp. La de utilidad se usa para las plantillas y también para
# los mensajes de servicio (texto libre dentro de la ventana de 24 h) que pasan de los gratis del
# mes por número. Opcionales: si falta alguna, el panel muestra solo unidades y no pesos.
TARIFA_IA_ENTRADA_COP_MILLON=
TARIFA_IA_SALIDA_COP_MILLON=
TARIFA_AUDIO_COP_MINUTO=
TARIFA_PLANTILLA_UTILIDAD_COP=
# Mensajes de servicio gratis al mes por número de WhatsApp. Opcional: sin ella, 1000.
MENSAJES_SERVICIO_GRATIS_MES=

# Carpeta de las imágenes que envían los clientes (relativa a backend/ o absoluta).
# Son datos personales: inclúyela en los backups y nunca la subas al repositorio.
ARCHIVOS_DIR=archivos

# Días que se guarda cada imagen de un cliente desde que llegó; después se borra del disco. 0 = nunca.
RETENCION_IMAGENES_DIAS=180

# Rechaza contraseñas nuevas que aparecen en filtraciones públicas (Pwned Passwords, k-anonimato).
# Si el servicio no responde, la contraseña se acepta. Pon true para activarla.
REVISAR_CONTRASENAS_FILTRADAS=false
