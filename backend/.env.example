# Copia este archivo como ".env" dentro de backend/ y ajusta los valores.
# El archivo ".env" real NUNCA se sube a GitHub.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Conexión con el rol de la aplicación (turnoo_app, NO turnoo_admin).
# Desde tu equipo el puerto es 5433 (el de docker-compose.yml).
DATABASE_URL=postgresql://turnoo_app:CAMBIA_ESTA_CONTRASENA@localhost:5433/turnoo

# Dirección del panel web (para los enlaces de invitación y recuperación de contraseña).
PANEL_URL=http://localhost:3001
