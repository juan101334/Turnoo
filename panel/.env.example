# Copia este archivo como ".env.local" dentro de panel/ y ajusta los valores.
# El panel no guarda secretos: solo sabe dónde está el backend.

# Dirección del backend, vista desde el servidor del panel (nunca desde el navegador).
BACKEND_URL=http://localhost:3000

# Cuántos proxies propios hay delante del panel. 0 en desarrollo; 1 detrás de Caddy.
# Con 0 se ignora X-Forwarded-For. Con 1 se toma la IP que agregó Caddy (la última de la lista),
# y lo que el navegador haya escrito antes se descarta. Un valor mayor al real permite falsificar la IP.
SALTOS_PROXY=0
